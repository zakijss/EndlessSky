# CMake toolchain for the Miyoo Mini Plus (run inside the es-zig container).
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7l)
set(MIYOO_CROSS ${CMAKE_CURRENT_LIST_DIR})
set(CMAKE_C_COMPILER ${MIYOO_CROSS}/zcc)
set(CMAKE_CXX_COMPILER ${MIYOO_CROSS}/zcxx)
set(CMAKE_AR ${MIYOO_CROSS}/zar)
set(CMAKE_RANLIB ${MIYOO_CROSS}/zranlib)
# Libraries built by deps.sh are installed here.
set(MIYOO_PREFIX ${CMAKE_CURRENT_LIST_DIR}/../../build-miyoo/prefix)
set(CMAKE_FIND_ROOT_PATH ${MIYOO_PREFIX})
set(CMAKE_PREFIX_PATH ${MIYOO_PREFIX})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(BUILD_SHARED_LIBS OFF)
