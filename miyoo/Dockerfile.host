# Host (Linux) build and test image for the software renderer: build-soft, integration
# tests and screenshot tours. docker build -t es-host -f miyoo/Dockerfile.host miyoo
FROM debian:trixie
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends g++ cmake ninja-build pkg-config libsdl2-dev libpng-dev libjpeg-dev libavif-dev libglew-dev libopenal-dev libflac++-dev libminizip-dev uuid-dev libmad0-dev libopengl0 libglx0 libegl1 time python3 python3-pil && rm -rf /var/lib/apt/lists/*
